# Argo CD behind Traefik (TLS terminates at Traefik). Nobody gets in without a
# login: delegates share the read-only local account "delegate" (its password is
# on every access sheet), and changes reach the cluster only through Git. The
# admin password is in the argocd-initial-admin-secret secret.
global:
  domain: {{ pelab_hosts.argocd }}
configs:
  params:
    server.insecure: true
  cm:
    timeout.reconciliation: 60s
    users.anonymous.enabled: "false"
    # The delegates' account may only sign in (no API keys).
    accounts.{{ pelab_viewer_user }}: login
  rbac:
    # Nothing by default; the delegates' account gets the built-in read-only role.
    policy.default: ""
    policy.csv: |
      g, {{ pelab_viewer_user }}, role:readonly
  secret:
    # The account's password hash lands in argocd-secret next to the admin's.
    extra:
      accounts.{{ pelab_viewer_user }}.password: {{ pelab_viewer_password_bcrypt | to_json }}
  # Trust the lab CA when talking to Gitea and Harbor (OCI Helm charts).
  tls:
    certificates:
      {{ pelab_hosts.gitea }}: {{ platform_ca_pem | to_json }}
      {{ pelab_hosts.harbor }}: {{ platform_ca_pem | to_json }}
dex:
  enabled: false
# The ApplicationSet controller reads team repositories from Gitea's API.
applicationSet:
  extraEnv:
    - name: SSL_CERT_FILE
      value: /etc/pelab-ca/ca.crt
  extraVolumes:
    - name: pelab-ca
      configMap:
        name: pelab-ca
  extraVolumeMounts:
    - name: pelab-ca
      mountPath: /etc/pelab-ca
      readOnly: true
server:
  ingress:
    enabled: true
    ingressClassName: traefik
    tls: false
    extraTls:
      - secretName: {{ pelab_tls_secret_name }}
        hosts: ["{{ pelab_hosts.argocd }}"]
