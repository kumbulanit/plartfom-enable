# This repository is the Platform Engineering course: docs/ (decks and guides),
# labs/ (each day's instructions and code) and prelab-setup/ (the lab build).
# prelab-setup/.gitignore keeps the build's passwords, keys and backups out.

# Editor and operating-system files, anywhere.
.DS_Store
~$*
node_modules/
__pycache__/
*.pyc
# One person's tool settings.
.qodo/
# Slide decks: built from docs/slides/src (npm run decks); not committed for now.
*.pptx
# IDE settings.
.idea/
# The client brief stays out of git.
BRIEF_*.pdf

# Final project: kept local for now, not committed
labs/final-project/
docs/slides/src/content/project.js
docs/slides/src/final-project.js
