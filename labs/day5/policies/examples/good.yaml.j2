# A deployment the guardrails accept: the hello service as the golden path
# deploys it to dev. Change team01 to your team if you apply it yourself.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello
  namespace: team01-dev
  labels:
    app.kubernetes.io/name: hello
    app.kubernetes.io/part-of: team01
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: hello
  template:
    metadata:
      labels:
        app.kubernetes.io/name: hello
        app.kubernetes.io/part-of: team01
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          # From the lab registry, tagged with the commit it was built from.
          image: {{ pelab_hosts.harbor }}/team01/hello:3f9c2a7e1b0d4c5e6f7a8b9c0d1e2f3a4b5c6d7e
          ports:
            - name: http
              containerPort: 8081
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
