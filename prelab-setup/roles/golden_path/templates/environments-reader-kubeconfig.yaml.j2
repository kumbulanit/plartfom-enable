apiVersion: v1
kind: Config
clusters:
  - name: pelab
    cluster:
      server: https://{{ pelab_lxd_gateway }}:6443
      certificate-authority-data: {{ golden_path_reader_token.resources[0].data['ca.crt'] }}
users:
  - name: environments-reader
    user:
      token: {{ golden_path_reader_token.resources[0].data.token | b64decode }}
contexts:
  - name: environments-reader
    context:
      cluster: pelab
      user: environments-reader
current-context: environments-reader
