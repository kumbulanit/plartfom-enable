# Copy this file to <your team>.tf (for example team01.tf), replace team00 in both
# places, and open a pull request. The plan in the pull request shows what will be
# created before anything changes.

module "team00" {
  source       = "./modules/team-environment"
  team         = "team00"
  environments = ["staging", "prod"]
  size         = "small"
}
