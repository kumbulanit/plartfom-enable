---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ teams_users_namespace }}
  labels:
    pelab.io/tier: platform
---
# Cluster-wide read access every delegate gets: enough to explore the cluster
# and see policies, without reading other teams' workloads or secrets.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: pelab-delegate
rules:
  - apiGroups: [""]
    resources: [namespaces, nodes]
    verbs: [get, list, watch]
  - apiGroups: [storage.k8s.io]
    resources: [storageclasses]
    verbs: [get, list, watch]
  - apiGroups: [networking.k8s.io]
    resources: [ingressclasses]
    verbs: [get, list, watch]
  - apiGroups: [apiextensions.k8s.io]
    resources: [customresourcedefinitions]
    verbs: [get, list, watch]
  - apiGroups: [kyverno.io]
    resources: [clusterpolicies, policies]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: pelab-delegates
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: pelab-delegate
subjects:
{% for name in pelab_workspace_names %}
  - kind: ServiceAccount
    name: {{ name }}
    namespace: {{ teams_users_namespace }}
{% endfor %}
{% for name in pelab_workspace_names %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ name }}
  namespace: {{ teams_users_namespace }}
  labels:
    pelab.io/team: "{{ pelab_workspace_teams[name] | default('none') }}"
---
apiVersion: v1
kind: Secret
type: kubernetes.io/service-account-token
metadata:
  name: {{ name }}-token
  namespace: {{ teams_users_namespace }}
  labels:
    pelab.io/token: delegate
  annotations:
    kubernetes.io/service-account.name: {{ name }}
{% endfor %}
{% for team in pelab_team_names %}
{% for env in teams_environments %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ team }}-members
  namespace: {{ team }}-{{ env }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ teams_member_roles[env] }}
subjects:
{% for name in pelab_workspace_names if pelab_workspace_teams[name] | default('') == team %}
  - kind: ServiceAccount
    name: {{ name }}
    namespace: {{ teams_users_namespace }}
{% else %}
  []
{% endfor %}
{% endfor %}
{% endfor %}
