# The platform as a product: its services, the golden path and who runs them.
apiVersion: backstage.io/v1alpha1
kind: System
metadata:
  name: pelab-platform
  title: PE Lab Internal Developer Platform
  description: The shared services every team builds, ships and runs on.
spec:
  owner: group:platform-team
---
apiVersion: backstage.io/v1alpha1
kind: System
metadata:
  name: pelab-apps
  title: Team services
  description: Services the teams have built on the golden path.
spec:
  owner: group:platform-team
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: golden-path
  title: Golden path - Python web service
  description: >-
    Create a new service with code, tests, a pipeline, deployments for dev, test and
    prod, a dashboard and a catalog entry, without asking anyone for access.
  tags: [template, python]
  links:
    - url: https://{{ pelab_hosts.gitea }}/repo/create?template_id={{ golden_path_template_id }}
      title: Create a service from the golden path
    - url: https://{{ pelab_hosts.gitea }}/{{ golden_path_platform_org }}/{{ golden_path_template_repo }}
      title: User guide (template README)
    - url: https://{{ pelab_hosts.gitea }}/{{ golden_path_platform_org }}/{{ golden_path_template_repo }}/issues
      title: Ask the platform team
spec:
  type: template
  lifecycle: production
  owner: group:platform-team
  system: pelab-platform
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: pipeline-templates
  title: Pipeline templates - smoke test, nightly scan
  description: >-
    Small ready-made pipelines to copy into any golden-path service, unchanged:
    a smoke test for dev, staging or prod, and a nightly vulnerability scan.
  tags: [template, pipeline]
  links:
    - url: https://{{ pelab_hosts.gitea }}/{{ golden_path_platform_org }}/{{ golden_path_pipeline_templates_repo }}
      title: The templates and how to use them
    - url: https://{{ pelab_hosts.gitea }}/{{ golden_path_platform_org }}/{{ golden_path_pipeline_templates_repo }}/issues
      title: Ask the platform team
spec:
  type: template
  lifecycle: production
  owner: group:platform-team
  system: pelab-platform
{% macro service(name, title, url, tags) %}
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: platform-{{ name }}
  title: {{ title }}
  tags: {{ tags | to_json }}
  links:
    - url: {{ url }}
      title: Open
spec:
  type: platform-service
  lifecycle: production
  owner: group:platform-team
  system: pelab-platform
{% endmacro %}
{{ service('gitea', 'Gitea - source control and pipelines', 'https://' ~ pelab_hosts.gitea, ['delivery']) }}
{{ service('harbor', 'Harbor - images, scanning and SBOMs', 'https://' ~ pelab_hosts.harbor, ['supply-chain']) }}
