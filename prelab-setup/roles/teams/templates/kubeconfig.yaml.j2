# {{ ansible_managed }}
# Kubernetes access for {{ item }} ({{ teams_team or 'no team' }}). Read-only mount:
# kubectl writes personal changes to ~/.kube/config instead (see $KUBECONFIG).
apiVersion: v1
kind: Config
clusters:
  - name: pelab
    cluster:
      server: {{ teams_kubeconfig_server }}
      certificate-authority-data: {{ teams_token.data['ca.crt'] }}
users:
  - name: {{ item }}
    user:
      token: {{ teams_token.data.token | b64decode }}
contexts:
{% if teams_team %}
{% for env in teams_context_environments %}
  - name: {{ teams_team }}-{{ env }}
    context:
      cluster: pelab
      user: {{ item }}
      namespace: {{ teams_team }}-{{ env }}
{% endfor %}
current-context: {{ teams_team }}-{{ teams_context_environments | first }}
{% else %}
  - name: pelab
    context:
      cluster: pelab
      user: {{ item }}
current-context: pelab
{% endif %}
