#!{{ pelab_venv }}/bin/python
# {{ ansible_managed }}
"""The platform applier: puts the approved state (main) of the request
repositories into the cluster, every {{ golden_path_applier_interval }} (pelab-platform-apply.timer).

  {{ golden_path_platform_org }}/{{ golden_path_environments_repo }}  `tofu apply`: the teams' staging and prod environments
  {{ golden_path_platform_org }}/{{ golden_path_policies_repo }}      the guardrails, and the exceptions that have not expired

It runs on the lab host with the cluster's admin credentials, which no pipeline
can see. Each result is posted on the commit as the status "{{ golden_path_applier_context }}".
Because it re-applies every run, hand-made changes (drift) are put back.

The delivery safety net (`pelab-safety-net on`, only if Argo CD gives trouble):
while {{ golden_path_safety_net_flag }} exists, Argo CD is kept paused and this
also deploys every team repository's deploy/<env> from main, as Argo CD would:
dev at the latest commit whose pipeline passed, staging and prod exactly as
committed. Each result is posted as the status "{{ golden_path_safety_net_context }}/<env>".
"""

import datetime
import json
import os
import pathlib
import re
import ssl
import subprocess
import sys
import urllib.request

import yaml

HOME = pathlib.Path("{{ golden_path_applier_dir }}")
GITEA = "{{ golden_path_gitea_url }}"
ORG = "{{ golden_path_platform_org }}"
CONTEXT = "{{ golden_path_applier_context }}"
EXCEPTIONS_NAMESPACE = "{{ golden_path_exception_namespace }}"
MANAGED = {"app.kubernetes.io/managed-by": "pelab-platform-apply"}
SAFETY_NET = pathlib.Path("{{ golden_path_safety_net_flag }}")
SAFETY_CONTEXT = "{{ golden_path_safety_net_context }}"
TEAMS = {{ pelab_team_names | to_json }}
ENVIRONMENTS = {{ pelab_environments | to_json }}
REQUESTED = {{ pelab_requested_environments | to_json }}  # the others exist from the start
KINDS = {{ golden_path_safety_net_kinds | to_json }}
HARBOR = "{{ pelab_hosts.harbor }}"
ARGOCD_CONTROLLERS = "{{ golden_path_argocd_controllers }}"
TOKEN = (HOME / "token").read_text().strip()
TLS = ssl.create_default_context(cafile="{{ pelab_tls_dir }}/ca.crt")
ENV = dict(
    os.environ,
    HOME=str(HOME),
    KUBECONFIG="{{ pelab_kubeconfig }}",
    KUBE_CONFIG_PATH="{{ pelab_kubeconfig }}",
    TF_IN_AUTOMATION="1",
    TF_CLI_CONFIG_FILE="/etc/opentofu/tofurc",
    PATH="/usr/local/bin:/usr/bin:/bin",
)


def run(args, cwd=None, stdin=None):
    result = subprocess.run(args, cwd=cwd, env=ENV, input=stdin, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"{' '.join(args[:3])} failed: {(result.stderr or result.stdout).strip()[-400:]}")
    return result.stdout


def api(path):
    request = urllib.request.Request(f"{GITEA}/api/v1/{path}", headers={"Authorization": f"token {TOKEN}"})
    with urllib.request.urlopen(request, context=TLS, timeout=30) as response:
        return json.load(response)


def checkout(repo, owner=ORG):
    """Fetch main into HOME/repos/<repo> (team services: HOME/services/<team>/<repo>); return (path, commit)."""
    path = HOME / "repos" / repo if owner == ORG else HOME / "services" / owner / repo
    path.mkdir(parents=True, exist_ok=True)
    if not (path / ".git").is_dir():
        run(["git", "init", "-q"], path)
    auth = ["-c", f"http.extraHeader=Authorization: token {TOKEN}"]
    run(["git", *auth, "fetch", "-q", "--depth", "1", f"{GITEA}/{owner}/{repo}.git", "main"], path)
    run(["git", "checkout", "-q", "--force", "FETCH_HEAD"], path)
    run(["git", "clean", "-q", "-fdx", "-e", ".terraform", "-e", ".terraform.lock.hcl"], path)
    return path, run(["git", "rev-parse", "HEAD"], path).strip()


def report(repo, commit, state, description, owner=ORG, context=CONTEXT):
    """Post a commit status, but only when something changed since the last run."""
    seen_file = HOME / "last-status.json"
    seen = json.loads(seen_file.read_text()) if seen_file.exists() else {}
    key = f"{owner}/{repo} {context}"
    if seen.get(key) == [commit, state, description]:
        return
    body = json.dumps({"state": state, "context": context, "description": description[:250]}).encode()
    request = urllib.request.Request(
        f"{GITEA}/api/v1/repos/{owner}/{repo}/statuses/{commit}",
        data=body,
        method="POST",
        headers={"Authorization": f"token {TOKEN}", "Content-Type": "application/json"},
    )
    urllib.request.urlopen(request, context=TLS, timeout=30).close()
    seen[key] = [commit, state, description]
    seen_file.write_text(json.dumps(seen))


def apply_environments(path):
    run(["tofu", "init", "-input=false", "-no-color"], path)
    out = run(["tofu", "apply", "-input=false", "-auto-approve", "-no-color", "-lock-timeout=120s"], path)
    summary = re.search(r"Resources: (\d+) added, (\d+) changed, (\d+) destroyed", out)
    if not summary or summary.groups() == ("0", "0", "0"):
        return "Up to date"
    return "Applied: {} added, {} changed, {} destroyed".format(*summary.groups())


def documents(folder):
    for file in sorted(folder.glob("*.yaml")):
        for doc in yaml.safe_load_all(file.read_text()):
            if doc:
                yield file, doc


def apply_policies(path):
    policies = [doc for _, doc in documents(path / "policies")]
    if policies:
        run(["k3s", "kubectl", "apply", "-f", "-"], stdin=yaml.safe_dump_all(policies))

    today = datetime.date.today()
    wanted, expired = [], []
    for _, doc in documents(path / "exceptions"):
        if doc.get("kind") != "PolicyException":
            continue
        meta = doc.setdefault("metadata", {})
        expires = (meta.get("annotations") or {}).get("pelab.io/expires", "")
        try:
            valid = datetime.date.fromisoformat(str(expires)) >= today
        except ValueError:
            valid = False
        if not valid:
            expired.append(meta.get("name", "?"))
            continue
        meta["namespace"] = EXCEPTIONS_NAMESPACE
        meta["labels"] = {**(meta.get("labels") or {}), **MANAGED}
        wanted.append(doc)
    if wanted:
        run(["k3s", "kubectl", "apply", "-f", "-"], stdin=yaml.safe_dump_all(wanted))

    # Remove exceptions that expired or were deleted from main.
    selector = ",".join(f"{k}={v}" for k, v in MANAGED.items())
    current = json.loads(run(["k3s", "kubectl", "get", "policyexceptions.kyverno.io", "-n", EXCEPTIONS_NAMESPACE,
                              "-l", selector, "-o", "json"]))
    keep = {doc["metadata"]["name"] for doc in wanted}
    removed = [item["metadata"]["name"] for item in current["items"] if item["metadata"]["name"] not in keep]
    for name in removed:
        run(["k3s", "kubectl", "delete", "policyexceptions.kyverno.io", name, "-n", EXCEPTIONS_NAMESPACE])

    text = f"{len(policies)} policies, {len(wanted)} exceptions in force"
    if expired:
        text += f"; expired, not applied: {', '.join(sorted(expired))}"
    return text


# ------------------------------------------------------------ the safety net
def pause_argocd():
    """Keep Argo CD's controllers at 0 replicas while the safety net is on: only one may deploy."""
    run(["k3s", "kubectl", "--namespace=argocd", "scale", "statefulset,deployment",
         "--selector", ARGOCD_CONTROLLERS, "--replicas=0"])


def pipeline_state(owner, repo, commit):
    """failure, pending or success: the commit's pipeline checks (the safety net's own left out)."""
    combined = api(f"repos/{owner}/{repo}/commits/{commit}/status")
    latest = {}  # Gitea can list several statuses per check: only the newest counts
    for status in combined.get("statuses") or []:
        if status["context"] not in latest or status["id"] > latest[status["context"]]["id"]:
            latest[status["context"]] = status
    states = [status["status"] for context, status in latest.items()
              if not context.startswith(SAFETY_CONTEXT + "/")]
    if any(state in ("failure", "error") for state in states):
        return "failure"
    if any(state == "pending" for state in states):
        return "pending"
    return "success"  # all passed, or no pipeline ran on this commit


def deploy(path, owner, repo, env, tag=None):
    """Apply deploy/<env> into <owner>-<env>, as Argo CD would. Returns what is running."""
    folder = path / "deploy" / env
    image = f"{HARBOR}/{owner}/{repo}"
    if tag:  # dev runs the image the pipeline built from this commit
        file = folder / "kustomization.yaml"
        kustomization = yaml.safe_load(file.read_text())
        images = [item for item in kustomization.get("images") or [] if item.get("name") != image]
        kustomization["images"] = images + [{"name": image, "newTag": tag}]
        file.write_text(yaml.safe_dump(kustomization, sort_keys=False))
    docs = [doc for doc in yaml.safe_load_all(run(["k3s", "kubectl", "kustomize", str(folder)])) if doc]
    refused = sorted({str(doc.get("kind")) for doc in docs if doc.get("kind") not in KINDS})
    if refused:
        raise RuntimeError(f"the safety net does not deploy {', '.join(refused)}")
    namespace = f"{owner}-{env}"
    for doc in docs:  # only ever into the team's own namespace
        doc.setdefault("metadata", {})["namespace"] = namespace
    run(["k3s", "kubectl", "apply", f"--namespace={namespace}", "-f", "-"], stdin=yaml.safe_dump_all(docs))

    running = "nothing"
    for doc in docs:
        if doc["kind"] == "Deployment":
            container = doc["spec"]["template"]["spec"]["containers"][0]
            replicas = doc["spec"].get("replicas", 1)
            version = container["image"].rsplit(":", 1)[-1]
            version = version[:8] if re.fullmatch(r"[0-9a-f]{40}", version) else version
            running = f"{version}, {replicas} replica{'' if replicas == 1 else 's'}"
    return f"Deployed to {namespace}: {running}"


def namespace_exists(name):
    return subprocess.run(["k3s", "kubectl", "get", "namespace", name], env=ENV, capture_output=True).returncode == 0


def deliver_services():
    """Deploy every team service from main. Returns True if anything failed."""
    failed = False
    try:
        pause_argocd()
    except Exception as error:
        failed = True
        print(f"could not pause Argo CD: {error}", file=sys.stderr)
    for team in TEAMS:
        try:
            repos = [item["name"] for item in api(f"orgs/{team}/repos?limit=50")
                     if not item.get("empty") and not item.get("archived")]
        except Exception as error:
            failed = True
            print(f"{team}: could not list the repositories: {error}", file=sys.stderr)
            continue
        for repo in repos:
            try:
                path, commit = checkout(repo, owner=team)
            except Exception as error:
                failed = True
                print(f"{team}/{repo}: {error}", file=sys.stderr)
                continue
            for env in ENVIRONMENTS:
                if not (path / "deploy" / env / "kustomization.yaml").is_file():
                    continue
                namespace = f"{team}-{env}"
                try:
                    if not namespace_exists(namespace):
                        state, text = "pending", (
                            f"{namespace} does not exist yet: request it in {ORG}/{{ golden_path_environments_repo }}"
                            if env in REQUESTED else f"{namespace} does not exist: tell the instructor")
                    elif env == "dev" and (pipeline := pipeline_state(team, repo, commit)) != "success":
                        state, text = {
                            "pending": ("pending", "Waiting for the pipeline on this commit to finish"),
                            "failure": ("failure", "The pipeline failed on this commit: dev keeps the previous version"),
                        }[pipeline]
                    else:
                        state, text = "success", deploy(path, team, repo, env, commit if env == "dev" else None)
                except Exception as error:
                    failed = True
                    state, text = "failure", f"Not deployed: {error}"
                print(f"{team}/{repo} {env} {commit[:8]}: {text}")
                try:
                    report(repo, commit, state, text[:250], owner=team, context=f"{SAFETY_CONTEXT}/{env}")
                except Exception as error:
                    failed = True
                    print(f"{team}/{repo}: could not post the status: {error}", file=sys.stderr)
    return failed


def main():
    failed = False
    for repo, apply in (("{{ golden_path_environments_repo }}", apply_environments),
                        ("{{ golden_path_policies_repo }}", apply_policies)):
        commit = None
        try:
            path, commit = checkout(repo)
            description = apply(path)
            report(repo, commit, "success", description)
            print(f"{repo} {commit[:8]}: {description}")
        except Exception as error:  # report every failure on the commit, then carry on
            failed = True
            print(f"{repo}: {error}", file=sys.stderr)
            if commit:
                try:
                    report(repo, commit, "failure", f"Not applied: {error}"[:250])
                except Exception as report_error:
                    print(f"{repo}: could not post the status: {report_error}", file=sys.stderr)
    if SAFETY_NET.exists() and deliver_services():
        failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
